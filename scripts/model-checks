#!/usr/bin/env bash
# model-checks — blocking checks of the Ambrogio model over the whole workspace: Reqvire validation,
# Reqvire lint without findings, model integrity rules and an acyclic graph between repositories.
# Used by the pre-commit hooks and by CI of every repository of the model. Reqvire reads a temporary
# mirror of the files Git sees, so that installed dependencies do not slow it down.
#
# Usage: model-checks [--workspace DIR]   (default: the folder that contains ambrogio-model)
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=reqvire-workspace.sh
. "$HERE/reqvire-workspace.sh"

# Inside a Git hook, Git exports the repository of the commit; the checks read every repository.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
ROOT="$(workspace_root)"
while [ $# -gt 0 ]; do
  case "$1" in
    --workspace) ROOT="$(workspace_root "$2")"; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
reqvire_cmd
MIRROR="$(workspace_mirror "$ROOT")"
report="$(mktemp)"; trap 'rm -rf "$MIRROR" "$report"' EXIT

"${REQVIRE_CMD[@]}" --workspace "$MIRROR" validate >&2
"${REQVIRE_CMD[@]}" --workspace "$MIRROR" lint --json > "$report"
node -e '
const report = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
if (report.auto_fixable.length || report.needs_manual_review.length) {
  console.error(JSON.stringify(report, null, 2));
  console.error("model-checks: Reqvire lint has findings");
  process.exit(1);
}' "$report"
node "$HERE/check-model.mjs" "$ROOT" "$MIRROR"
python3 "$HERE/repo-deps" --workspace "$ROOT" --check-acyclic >/dev/null
