#!/usr/bin/env bash
# Block commits that add secrets or leave the model of the workspace invalid.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH; install gitleaks 8.30.1 (https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1) and retry." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner .
"$(git rev-parse --show-toplevel)/scripts/model-checks"
